# X/Twitter API Credentials
# Generate at https://developer.x.com/en/portal/dashboard
# App must have Read and Write permissions enabled
X_API_KEY=your_consumer_key_here
X_API_KEY_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Your bot's X handle (without @)
BOT_HANDLE=your_bot_handle

# Max replies per sweep (default 4)
MAX_REPLIES_PER_SWEEP=4

# Dry run mode — set to "true" to draft without posting
DRY_RUN=false
